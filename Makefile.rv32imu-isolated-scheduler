SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_DIR ?= build/rv32imu-isolated-scheduler
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32imu_isolated_scheduler.cpp
GENERATED_RV32IMU_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu.cpp
GENERATED_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu_pmp.cpp
TOP := AetherCoreRV32IMUPmpSimTop
VERILATOR ?= verilator
STALL_PERIODS := 0 5
MESSAGE_A := task A isolated
MESSAGE_B := task B survived

RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl software contract runner-source difftest-source sim local-reference clean

all: local-reference

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32IMUPmp --target-dir $(RTL_DIR)

software:
	python3 tools/make_rv32imu_isolated_scheduler.py $(SOFTWARE_DIR)

contract: software
	grep -q '^march=rv32im_zicsr$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^privileges=MU$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^pmp_entries=4$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^pmp_mode=dynamic-tor$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^syscalls=write,get_ticks,yield,exit$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_task_a_state=killed$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_task_b_state=exited$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_cross_task_faults=1$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^task_a_main 0x80004000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_a_counter 0x80005000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_a_attack_b_data ' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_main 0x80006000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_counter 0x80007000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_ready 0x80007004$$' $(SOFTWARE_DIR)/labels.txt

runner-source:
	mkdir -p $(BUILD_DIR)
	python3 tools/make_rv32imu_pmp_runner.py \
		sim/sim_main.cpp $(GENERATED_MAIN)

difftest-source:
	mkdir -p $(BUILD_DIR)
	python3 tools/make_rv32imu_difftest.py \
		sim/nemu_difftest_rv32.cpp $(GENERATED_RV32IMU_DIFFTEST)
	python3 tools/widen_rv32imu_pmp_csr_decode.py \
		$(GENERATED_RV32IMU_DIFFTEST)
	python3 tools/make_rv32imu_pmp_difftest.py \
		$(GENERATED_RV32IMU_DIFFTEST) $(GENERATED_DIFFTEST)

sim: rtl runner-source difftest-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IMU PMP SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) \
		$(abspath $(GENERATED_DIFFTEST))

local-reference: sim contract
	mkdir -p $(BUILD_DIR)/logs
	@for stall in $(STALL_PERIODS); do \
		echo "== RV32IMU isolated scheduler: stall=$$stall =="; \
		args=""; \
		if [[ "$$stall" != "0" ]]; then args="--stall-period $$stall"; fi; \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/isolated-scheduler.bin \
			--max-cycles 200000 --self-check-exit $$args \
			2>&1 | tee $(BUILD_DIR)/logs/stall-$$stall.log; \
		test "$$(grep -c '^$(MESSAGE_A)$$' $(BUILD_DIR)/logs/stall-$$stall.log)" -eq 1; \
		test "$$(grep -c '^$(MESSAGE_B)$$' $(BUILD_DIR)/logs/stall-$$stall.log)" -eq 1; \
		grep -Fq 'PASS: self-check exit=0' $(BUILD_DIR)/logs/stall-$$stall.log; \
		! grep -Fq 'FAIL:' $(BUILD_DIR)/logs/stall-$$stall.log; \
	done

clean:
	rm -rf $(BUILD_DIR)
