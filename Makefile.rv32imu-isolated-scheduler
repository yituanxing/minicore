SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_DIR ?= build/rv32imu-isolated-scheduler
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
PMP_MAIN := $(BUILD_DIR)/sim_main_rv32imu_pmp.cpp
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32imu_isolated_scheduler.cpp
GENERATED_RV32IMU_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu.cpp
PMP_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu_pmp.cpp
GENERATED_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu_isolated_scheduler.cpp
TOP := AetherCoreRV32IMUPmpSimTop
VERILATOR ?= verilator
RV32_NEMU_SO ?=
STALL_PERIODS := 0 5
MISMATCH_EVENT ?= 0
MESSAGE_A := task A isolated
MESSAGE_B := task B survived

RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl software contract runner-source difftest-source sim local-reference run mismatch-probe clean

all: local-reference

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32IMUPmp --target-dir $(RTL_DIR)

software:
	python3 tools/make_rv32imu_isolated_scheduler.py $(SOFTWARE_DIR)

contract: software
	grep -q '^march=rv32im_zicsr$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^privileges=MU$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^hardware_pmp_entries=16$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^pmp_shadow_entries=4$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^pmp_entries_configured=0,1,2$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^pmp_mode=dynamic-tor$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^syscalls=write,get_ticks,yield,exit$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_task_a_state=killed$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_task_b_state=exited$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^expected_cross_task_faults=1$$' $(SOFTWARE_DIR)/manifest.txt
	grep -q '^task_a_main 0x80004000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_a_counter 0x80005000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_a_attack_b_data ' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_main 0x80006000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_counter 0x80007000$$' $(SOFTWARE_DIR)/labels.txt
	grep -q '^task_b_ready 0x80007004$$' $(SOFTWARE_DIR)/labels.txt

runner-source:
	mkdir -p $(BUILD_DIR)
	python3 tools/make_rv32imu_pmp_runner.py \
		sim/sim_main.cpp $(PMP_MAIN)
	python3 tools/make_rv32imu_isolated_scheduler_adapters.py runner \
		$(PMP_MAIN) $(GENERATED_MAIN)

difftest-source:
	mkdir -p $(BUILD_DIR)
	python3 tools/make_rv32imu_difftest.py \
		sim/nemu_difftest_rv32.cpp $(GENERATED_RV32IMU_DIFFTEST)
	python3 tools/widen_rv32imu_pmp_csr_decode.py \
		$(GENERATED_RV32IMU_DIFFTEST)
	python3 tools/make_rv32imu_pmp_difftest.py \
		$(GENERATED_RV32IMU_DIFFTEST) $(PMP_DIFFTEST)
	python3 tools/make_rv32imu_isolated_scheduler_adapters.py difftest \
		$(PMP_DIFFTEST) $(GENERATED_DIFFTEST)

sim: rtl runner-source difftest-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IMU PMP SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) \
		$(abspath $(GENERATED_DIFFTEST))

local-reference: sim contract
	mkdir -p $(BUILD_DIR)/logs
	@for stall in $(STALL_PERIODS); do \
		echo "== RV32IMU isolated scheduler local reference: stall=$$stall =="; \
		args=""; \
		if [[ "$$stall" != "0" ]]; then args="--stall-period $$stall"; fi; \
		log="$(BUILD_DIR)/logs/stall-$$stall.log"; \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/isolated-scheduler.bin \
			--max-cycles 200000 --self-check-exit $$args \
			2>&1 | tee "$$log"; \
		test "$$(grep -c '^$(MESSAGE_A)$$' "$$log")" -eq 1; \
		test "$$(grep -c '^$(MESSAGE_B)$$' "$$log")" -eq 1; \
		grep -Fq 'PASS: self-check exit=0' "$$log"; \
		! grep -Fq 'FAIL:' "$$log"; \
	done

run: sim contract
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the exact RV32 NEMU reference"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(BUILD_DIR)/logs
	@for stall in $(STALL_PERIODS); do \
		echo "== RV32IMU isolated scheduler DiffTest: stall=$$stall =="; \
		args=""; \
		if [[ "$$stall" != "0" ]]; then args="--stall-period $$stall"; fi; \
		log="$(BUILD_DIR)/logs/difftest-stall-$$stall.log"; \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/isolated-scheduler.bin \
			--max-cycles 200000 --self-check-exit $$args \
			--difftest "$(RV32_NEMU_SO)" \
			2>&1 | tee "$$log"; \
		test "$$(grep -c '^$(MESSAGE_A)$$' "$$log")" -eq 1; \
		test "$$(grep -c '^$(MESSAGE_B)$$' "$$log")" -eq 1; \
		grep -Fq 'PASS: self-check exit=0' "$$log"; \
		grep -Eq 'difftest=[1-9][0-9]*' "$$log"; \
		grep -Eq 'zicsr-shadow=[1-9][0-9]*' "$$log"; \
		grep -Eq 'trap-shadow=[1-9][0-9]*' "$$log"; \
		grep -Eq 'mret-shadow=[1-9][0-9]*' "$$log"; \
		grep -Eq 'interrupt-shadow=[1-9][0-9]*' "$$log"; \
		! grep -Fq 'FAIL:' "$$log"; \
	done

mismatch-probe: sim contract
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the exact RV32 NEMU reference"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(BUILD_DIR)/logs
	@set +e; \
	AETHERCORE_RV32_DIFFTEST_INJECT_MISMATCH_AT=$(MISMATCH_EVENT) \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/isolated-scheduler.bin \
			--max-cycles 200000 --self-check-exit --stall-period 5 \
			--difftest "$(RV32_NEMU_SO)" \
			> $(BUILD_DIR)/logs/mismatch.log 2>&1; \
	status=$$?; \
	set -e; \
	test "$$status" -ne 0; \
	grep -q 'RV32 DiffTest mismatch after $(MISMATCH_EVENT) matched events' \
		$(BUILD_DIR)/logs/mismatch.log; \
	grep -q 'x31' $(BUILD_DIR)/logs/mismatch.log

clean:
	rm -rf $(BUILD_DIR)
