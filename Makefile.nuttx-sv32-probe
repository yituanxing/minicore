SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_DIR ?= build/nuttx-sv32-boot-probe
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
IMAGE := $(BUILD_DIR)/nuttx.bin
KERNEL_IMAGE := $(BUILD_DIR)/nuttx-kernel.bin
BOOT_SRC := $(BUILD_DIR)/n5c-handoff.S
BOOT_ELF := $(BUILD_DIR)/n5c-handoff.elf
BOOT_BIN := $(BUILD_DIR)/n5c-handoff.bin
TOP := AetherCoreNuttXPagingSimTop
VERILATOR ?= verilator
JOBS ?= 6
NUTTX_ELF ?=
MAX_CYCLES ?= 20000000
RAM_BASE := 0x80000000
RAM_LIMIT := 0x90000000

.PHONY: all rtl image sim run-local clean

all: run-local

rtl:
	mkdir -p $(RTL_DIR) $(BUILD_DIR)/logs
	@test -f ./mill || { echo "ERROR: mill launcher is missing"; exit 4; }
	chmod +x ./mill
	set +e; \
		./mill aethercore.runMain aethercore.ElaborateNuttXPaging --target-dir $(RTL_DIR) \
			2>&1 | tee $(BUILD_DIR)/logs/rtl-build.log; \
		rc=$${PIPESTATUS[0]}; \
	set -e; \
	exit $$rc

image:
	@test -n "$(NUTTX_ELF)" || { echo "ERROR: set NUTTX_ELF=/path/to/nuttx.elf"; exit 2; }
	@test -s "$(NUTTX_ELF)"
	mkdir -p $(BUILD_DIR)
	riscv64-unknown-elf-readelf -h -l "$(NUTTX_ELF)" | tee $(BUILD_DIR)/nuttx-readelf.txt
	entry="$$(riscv64-unknown-elf-readelf -h "$(NUTTX_ELF)" | awk '/Entry point address:/{print $$4; exit}')"; \
	first_load="$$(riscv64-unknown-elf-readelf -l "$(NUTTX_ELF)" | awk '/^[[:space:]]*LOAD/{print $$4; exit}')"; \
	entry_dec=$$((entry)); \
	first_load_dec=$$((first_load)); \
	ram_base_dec=$$(($(RAM_BASE))); \
	ram_limit_dec=$$(($(RAM_LIMIT))); \
	[[ $$first_load_dec -ge $$ram_base_dec && $$first_load_dec -lt $$ram_limit_dec ]] || { \
		echo "ERROR: first NuttX LOAD paddr $$first_load is outside runner RAM [$(RAM_BASE),$(RAM_LIMIT))"; exit 3; \
	}; \
	[[ $$entry_dec -eq $$first_load_dec ]] || { \
		echo "ERROR: NuttX entry $$entry does not match first LOAD paddr $$first_load"; exit 3; \
	}; \
	load_offset=$$((first_load_dec - ram_base_dec)); \
	printf '%s\n' \
		'.section .text.boot,"ax",@progbits' \
		'.globl _start' \
		'_start:' \
		'  li a0, 0' \
		'  li a1, 0' \
		'  li t0, 0xb000' \
		'  csrw medeleg, t0' \
		'  li t0, 0x20' \
		'  csrw mideleg, t0' \
		'  li t0, 0x2' \
		'  csrw mcounteren, t0' \
		'  li t0, 0x80000000' \
		'  csrw 0x31a, t0' \
		'  li t0, 0x800' \
		'  csrw mstatus, t0' \
		"  li t0, $$entry" \
		'  csrw mepc, t0' \
		'  mret' \
		'1: j 1b' > $(BOOT_SRC); \
	riscv64-unknown-elf-gcc -march=rv32ima_zicsr_zifencei -mabi=ilp32 \
		-nostdlib -nostartfiles -Wl,--build-id=none -Wl,-e,_start -Wl,-Ttext=$(RAM_BASE) \
		-o $(BOOT_ELF) $(BOOT_SRC); \
	riscv64-unknown-elf-objcopy -O binary $(BOOT_ELF) $(BOOT_BIN); \
	riscv64-unknown-elf-objcopy -O binary "$(NUTTX_ELF)" $(KERNEL_IMAGE); \
	boot_size="$$(stat -c %s $(BOOT_BIN))"; \
	[[ $$boot_size -le $$load_offset ]] || { \
		echo "ERROR: N5-C handoff image ($$boot_size bytes) overlaps NuttX at offset $$load_offset"; exit 3; \
	}; \
	cp $(BOOT_BIN) $(IMAGE); \
	truncate -s $$load_offset $(IMAGE); \
	cat $(KERNEL_IMAGE) >> $(IMAGE); \
	image_size="$$(stat -c %s $(IMAGE))"; \
	[[ $$image_size -le $$((ram_limit_dec - ram_base_dec)) ]] || { \
		echo "ERROR: combined N5-C image exceeds runner RAM"; exit 3; \
	}; \
	echo "N5-C handoff: M-mode $(RAM_BASE) -> S-mode $$entry; page faults/STIP delegated, TM/STCE enabled; kernel offset=$$load_offset image-bytes=$$image_size" | tee $(BUILD_DIR)/image-layout.txt
	sha256sum "$(NUTTX_ELF)" $(BOOT_BIN) $(KERNEL_IMAGE) $(IMAGE) | tee $(BUILD_DIR)/images.sha256

sim: rtl
	@test -n "$$(find $(RTL_DIR) -maxdepth 1 -name '*.sv' -print -quit)" || { echo "ERROR: no paging RTL generated"; exit 4; }
	mkdir -p $(BUILD_DIR)/logs
	set +e; \
		$(VERILATOR) --cc --exe --build -Wall -Wno-fatal \
			--top-module $(TOP) -Mdir $(OBJ_DIR) \
			-CFLAGS "-std=c++20 -O2" \
			$(RTL_DIR)/*.sv $(abspath sim/nuttx_paging_boot_main.cpp) \
			-j $(JOBS) 2>&1 | tee $(BUILD_DIR)/logs/verilator-build.log; \
		rc=$${PIPESTATUS[0]}; \
	set -e; \
	exit $$rc

run-local: image sim
	mkdir -p $(BUILD_DIR)/logs
	set +e; \
		$(OBJ_DIR)/V$(TOP) $(IMAGE) $(MAX_CYCLES) 2>&1 | tee $(BUILD_DIR)/logs/boot-probe.log; \
		rc=$${PIPESTATUS[0]}; \
	set -e; \
	if [[ $$rc -ne 0 ]]; then \
		echo "ERROR: N5-C boot probe failed before NSH (runner rc=$$rc)"; \
		exit $$rc; \
	fi
	grep -q 'N5C_BOOT_REACHED_NSH' $(BUILD_DIR)/logs/boot-probe.log || { \
		echo "ERROR: N5-C returned success without the NSH milestone"; exit 5; \
	}
	sha256sum $(BUILD_DIR)/logs/boot-probe.log

clean:
	rm -rf $(BUILD_DIR)
