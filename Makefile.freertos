SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_RULES := Makefile.freertos
BUILD_DIR ?= build/freertos-qualification
SOURCE_DIR := $(BUILD_DIR)/FreeRTOS-Kernel
SOURCE_STAMP := $(BUILD_DIR)/.freertos-source-ready
CONTRACT := $(BUILD_DIR)/port-contract.json
LOCK_FILE := software/freertos/FreeRTOS-Kernel.lock
APP_DIR := software/freertos/aethercore
OBJ_DIR := $(BUILD_DIR)/obj
ELF := $(BUILD_DIR)/aethercore-freertos.elf
BIN := $(BUILD_DIR)/aethercore-freertos.bin
MAP := $(BUILD_DIR)/aethercore-freertos.map
DIS := $(BUILD_DIR)/aethercore-freertos.dis
ATTRIBUTES := $(BUILD_DIR)/aethercore-freertos.attributes
TOOLCHAIN_PROBE := $(BUILD_DIR)/toolchain-sysroot-probe.o

RTL_DIR := $(BUILD_DIR)/rtl
RTL_STAMP := $(RTL_DIR)/.aethercore-rtl-ready
SIM_OBJ_DIR := $(BUILD_DIR)/sim-obj
SIM_BINARY := $(SIM_OBJ_DIR)/VAetherCoreRV32IMTrapSimTop
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32im_freertos.cpp
RUNNER_TOOL := tools/make_freertos_runner.py
TOP := AetherCoreRV32IMTrapSimTop
RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)
SCALA_SOURCES := $(shell find src/main/scala -type f -name '*.scala' -print) build.mill

CROSS_COMPILE ?= riscv-none-elf-
CC := $(CROSS_COMPILE)gcc
OBJCOPY := $(CROSS_COMPILE)objcopy
OBJDUMP := $(CROSS_COMPILE)objdump
READELF := $(CROSS_COMPILE)readelf
VERILATOR ?= verilator
JOBS ?= $(shell nproc)
TRACE ?= 1
ifeq ($(TRACE),1)
VERILATOR_TRACE_FLAGS := --trace
else
VERILATOR_TRACE_FLAGS :=
endif
TRACE_STAMP := $(BUILD_DIR)/.trace-$(TRACE)

TOOLCHAIN_SYSROOT := $(shell $(CC) --print-sysroot 2>/dev/null)
SYSROOT_FLAGS := --sysroot=$(TOOLCHAIN_SYSROOT)
ARCH_FLAGS := -march=rv32im_zicsr -mabi=ilp32 -mcmodel=medany -msmall-data-limit=0
LIBRARY_ARCH_FLAGS := -march=rv32im -mabi=ilp32
DEBUG_PREFIX_ROOT := /aethercore/freertos-build
DEBUG_PREFIX_FLAGS := \
	-ffile-prefix-map=$(abspath $(BUILD_DIR))=$(DEBUG_PREFIX_ROOT) \
	-fdebug-prefix-map=$(abspath $(BUILD_DIR))=$(DEBUG_PREFIX_ROOT) \
	-fmacro-prefix-map=$(abspath $(BUILD_DIR))=$(DEBUG_PREFIX_ROOT)
COMMON_FLAGS := $(SYSROOT_FLAGS) $(ARCH_FLAGS) $(DEBUG_PREFIX_FLAGS) \
	-ffreestanding -fno-builtin -fdata-sections -ffunction-sections
CFLAGS := $(COMMON_FLAGS) -std=c11 -Os -g -Wall -Wextra
ASFLAGS := $(COMMON_FLAGS) -x assembler-with-cpp
LDFLAGS := $(SYSROOT_FLAGS) $(ARCH_FLAGS) -nostdlib -nostartfiles \
	-Wl,--gc-sections -Wl,--build-id=none -Wl,-Map,$(MAP) \
	-T $(APP_DIR)/linker.ld

PORT_DIR := $(SOURCE_DIR)/portable/GCC/RISC-V
CHIP_EXTENSION_DIR := $(PORT_DIR)/chip_specific_extensions/RISCV_MTIME_CLINT_no_extensions
INCLUDES := -I$(APP_DIR) -I$(SOURCE_DIR)/include -I$(PORT_DIR) -I$(CHIP_EXTENSION_DIR)

KERNEL_C_SOURCES := tasks.c queue.c list.c
KERNEL_OBJECTS := $(addprefix $(OBJ_DIR)/,$(KERNEL_C_SOURCES:.c=.o))
PORT_OBJECTS := $(OBJ_DIR)/port.o $(OBJ_DIR)/portASM.o $(OBJ_DIR)/heap_4.o
APP_C_SOURCES := main.c platform.c runtime.c
APP_OBJECTS := $(addprefix $(OBJ_DIR)/,$(APP_C_SOURCES:.c=.o)) $(OBJ_DIR)/startup.o
OBJECTS := $(APP_OBJECTS) $(KERNEL_OBJECTS) $(PORT_OBJECTS)

.PHONY: all source audit toolchain-check qualification elf image rtl runner-source sim run-local clean

all: image

$(SOURCE_STAMP): $(LOCK_FILE) tools/fetch_freertos_kernel.sh
	mkdir -p $(BUILD_DIR)
	rm -f $(SOURCE_DIR)/.aethercore-source-ready
	bash tools/fetch_freertos_kernel.sh $(SOURCE_DIR)
	rm -f $(SOURCE_DIR)/.aethercore-source-ready
	touch $@

source: $(SOURCE_STAMP)

$(CONTRACT): $(SOURCE_STAMP) tools/audit_freertos_riscv_port.py
	python3 tools/audit_freertos_riscv_port.py $(SOURCE_DIR) $(CONTRACT)

audit: $(CONTRACT)

toolchain-check:
	mkdir -p $(BUILD_DIR)
	test -n "$(TOOLCHAIN_SYSROOT)"
	test "$$($(CC) -dumpmachine)" = "riscv-none-elf"
	test "$$($(CC) -dumpfullversion)" = "15.2.0"
	test -f "$(TOOLCHAIN_SYSROOT)/include/stdlib.h"
	test -f "$(TOOLCHAIN_SYSROOT)/include/string.h"
	test "$$($(CC) $(LIBRARY_ARCH_FLAGS) -print-multi-directory)" = "rv32im/ilp32"
	test -f "$$($(CC) $(LIBRARY_ARCH_FLAGS) -print-file-name=libc.a)"
	test -f "$$($(CC) $(LIBRARY_ARCH_FLAGS) -print-libgcc-file-name)"
	printf '%s\n' '#include <stddef.h>' '#include <stdint.h>' '#include <stdlib.h>' '#include <string.h>' \
		'_Static_assert(sizeof(void *) == 4, "RV32 pointer width");' \
		'int probe(void *d, const void *s, size_t n) { return memcmp(memcpy(d, s, n), s, n); }' | \
		$(CC) $(SYSROOT_FLAGS) $(ARCH_FLAGS) -ffreestanding -fno-builtin -std=c11 \
		-x c -c -o $(TOOLCHAIN_PROBE) -
	$(READELF) -h $(TOOLCHAIN_PROBE) | grep -q 'Class:[[:space:]]*ELF32'
	$(READELF) -h $(TOOLCHAIN_PROBE) | grep -q 'Machine:[[:space:]]*RISC-V'
	rm -f $(TOOLCHAIN_PROBE)
	@echo "PASS: pinned RISC-V newlib sysroot is complete for RV32 ILP32"

qualification: $(CONTRACT) toolchain-check
	grep -q '"status": "PASS"' $(CONTRACT)
	grep -q '"release": "V11.3.0"' $(CONTRACT)
	grep -q '"profile": "rv32im_zicsr_m"' $(CONTRACT)
	grep -q '"mhartid": 0' $(CONTRACT)
	grep -q '"additional_context_registers": 0' $(CONTRACT)
	@echo "PASS: pinned FreeRTOS RV32 source and port qualification"

$(OBJ_DIR):
	mkdir -p $@

# Application sources include FreeRTOS headers. On a cold parallel build they
# must not race the pinned kernel fetch that materializes those headers.
$(OBJ_DIR)/%.o: $(APP_DIR)/%.c $(APP_DIR)/FreeRTOSConfig.h $(APP_DIR)/platform.h $(SOURCE_STAMP) $(BUILD_RULES) | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/startup.o: $(APP_DIR)/startup.S $(BUILD_RULES) | $(OBJ_DIR)
	$(CC) $(ASFLAGS) $(INCLUDES) -c $< -o $@

$(OBJ_DIR)/port.o: $(SOURCE_STAMP) $(BUILD_RULES) | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $(PORT_DIR)/port.c -o $@

$(OBJ_DIR)/portASM.o: $(SOURCE_STAMP) $(BUILD_RULES) | $(OBJ_DIR)
	$(CC) $(ASFLAGS) $(INCLUDES) -c $(PORT_DIR)/portASM.S -o $@

$(OBJ_DIR)/heap_4.o: $(SOURCE_STAMP) $(BUILD_RULES) | $(OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $(SOURCE_DIR)/portable/MemMang/heap_4.c -o $@

define KERNEL_C_RULE
$(OBJ_DIR)/$(1:.c=.o): $(SOURCE_STAMP) $(BUILD_RULES) | $(OBJ_DIR)
	$$(CC) $$(CFLAGS) $$(INCLUDES) -c $$(SOURCE_DIR)/$(1) -o $$@
endef
$(foreach source,$(KERNEL_C_SOURCES),$(eval $(call KERNEL_C_RULE,$(source))))

$(ELF): $(OBJECTS) $(APP_DIR)/linker.ld $(BUILD_RULES)
	$(CC) $(LDFLAGS) $(OBJECTS) -lgcc -o $@
	$(OBJDUMP) -d $@ > $(DIS)
	$(READELF) -A $@ > $(ATTRIBUTES)
	grep -q '<_start>:' $(DIS)
	grep -q '<main>:' $(DIS)
	grep -q '<xPortStartScheduler>:' $(DIS)
	grep -q '<freertos_risc_v_trap_handler>:' $(DIS)
	grep -Eq '\bcsrr[[:space:]].*mhartid' $(DIS)
	grep -q '\bmret\b' $(DIS)
	grep -Eq '\bwfi\b' $(DIS)

elf: $(ELF)

$(BIN): $(ELF)
	$(OBJCOPY) -O binary $< $@
	sha256sum $@ > $@.sha256

image: $(BIN)

$(RTL_STAMP): $(SCALA_SOURCES)
	rm -rf $(RTL_DIR)
	./mill aethercore.runMain aethercore.ElaborateRV32IMTrap --target-dir $(RTL_DIR)
	touch $@

rtl: $(RTL_STAMP)

$(TRACE_STAMP):
	mkdir -p $(BUILD_DIR)
	rm -f $(BUILD_DIR)/.trace-0 $(BUILD_DIR)/.trace-1
	touch $@

$(GENERATED_MAIN): sim/sim_main.cpp $(RUNNER_TOOL) $(TRACE_STAMP) $(BUILD_RULES)
	python3 $(RUNNER_TOOL) $< $@ --trace $(TRACE)

runner-source: $(GENERATED_MAIN)

$(SIM_BINARY): $(RTL_STAMP) $(GENERATED_MAIN) sim/nemu_difftest_rv32_timer.cpp $(BUILD_RULES)
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IM trap SystemVerilog files in $(RTL_DIR)"; exit 1; }
	+$(VERILATOR) --cc --exe --build -j $(JOBS) $(VERILATOR_TRACE_FLAGS) -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(SIM_OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) \
		$(abspath sim/nemu_difftest_rv32_timer.cpp)

sim: $(SIM_BINARY)

run-local: qualification image sim
	mkdir -p $(BUILD_DIR)/logs
	$(SIM_BINARY) $(BIN) \
		--max-cycles 2000000 --self-check-exit --stall-period 5 \
		2>&1 | tee $(BUILD_DIR)/logs/local.log
	test "$$(grep -c '^FREERTOS BOOT V11.3.0 RV32IM$$' $(BUILD_DIR)/logs/local.log)" -eq 1
	test "$$(grep -c '^FREERTOS IDLE PASS wfi>=1 wake>=1$$' $(BUILD_DIR)/logs/local.log)" -eq 1
	test "$$(grep -c '^FREERTOS PASS queue=64 semaphore=8 ticks>=16$$' $(BUILD_DIR)/logs/local.log)" -eq 1
	grep -Fq 'PASS: self-check exit=0' $(BUILD_DIR)/logs/local.log
	! grep -Fq 'FAIL:' $(BUILD_DIR)/logs/local.log

clean:
	rm -rf $(BUILD_DIR)