SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_DIR ?= build/rv32im-supervisor-v1
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32im_supervisor_v1.cpp
TOP := AetherCoreRV32IMSupervisorSimTop
VERILATOR ?= verilator
JOBS ?= 6

RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl workload runner-source sim run-local clean

all: run-local

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32IMSupervisor --target-dir $(RTL_DIR)

workload:
	bash tools/build_rv32im_supervisor_v1.sh $(SOFTWARE_DIR)

runner-source:
	mkdir -p $(BUILD_DIR)
	sed 's/VAetherCoreSimTop/VAetherCoreRV32IMSupervisorSimTop/g' sim/sim_main.cpp > $(GENERATED_MAIN)

sim: rtl runner-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IM Supervisor V1 SystemVerilog files in $(RTL_DIR)"; exit 1; }
	+$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) $(abspath sim/nemu_difftest_rv32.cpp) \
		-j $(JOBS)

run-local: sim workload
	mkdir -p $(BUILD_DIR)/logs
	@for stall in 0 3; do \
		echo "== RV32IM Supervisor V1: stall=$$stall =="; \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/supervisor-v1.bin \
			--max-cycles 8000 --self-check-exit --stall-period $$stall \
			2>&1 | tee $(BUILD_DIR)/logs/stall-$$stall.log; \
	done
	sha256sum \
		$(SOFTWARE_DIR)/supervisor-v1.elf \
		$(SOFTWARE_DIR)/supervisor-v1.bin \
		$(BUILD_DIR)/logs/stall-0.log \
		$(BUILD_DIR)/logs/stall-3.log

clean:
	rm -rf $(BUILD_DIR)
