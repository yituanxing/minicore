  "identities": [
    {
      "id": "RobToken",
      "owner": "rob",
      "birth": "atomic ordered ROB allocation",
      "validate": "slot plus generation and live occupancy; never index alone",
      "end": "retire or younger squash; generation changes upon reuse",
      "not_equal_to": [
        "ProducerTag",
        "ValueRef",
        "MemTxnId"
      ]
    },
    {
      "id": "ProducerTag",
      "owner": "rename",
      "birth": "new destination producer at rename",
      "validate": "physical generation and live producer; x0 never produces",
      "end": "retire/replacement or invalidation of killed producer",
      "not_equal_to": [
        "RobToken",
        "ValueRef"
      ]
    },
    {
      "id": "ValueRef",
      "owner": "prf",
      "birth": "physical destination reserved with rename",
      "validate": "physid plus reservation lifetime; never ROB slot alone",
      "end": "old physical released exactly once when overwriter safely commits or on killed new allocation",
      "not_equal_to": [
        "ProducerTag",
        "RobToken"
      ]
    },
    {
      "id": "MemTxnId",
      "owner": "memory_transport",
      "birth": "accepted external request / MSHR allocation",
      "validate": "live transport table entry, not only surviving ROB lifetime",
      "end": "terminal response consumed or killed transaction drained safely",
      "not_equal_to": [
        "RobToken"
      ]
    },
    {
      "id": "BranchEpoch",
      "owner": "recovery",
      "birth": "redirect/recovery boundary issuance",
      "validate": "fetch/execute result must carry valid scope and survivor age",
      "end": "superseded epoch releases after stale work drained",
      "not_equal_to": [
        "RobToken"
      ]
    },
    {
      "id": "FpEffect",
      "owner": "rob",
      "birth": "exception flags and FP result completion bound to live token",
      "validate": "full ROB lifetime, never speculative FCSR update",
      "end": "precise in-order commit or squash",
      "not_equal_to": [
        "MemTxnId"
      ]
    }
  ],
  "required_interfaces": [
    {
      "id": "FetchGroup",
      "producer": "frontend",
      "consumer": "decode",
      "fields": [
        "pc",
        "raw_instruction",
        "inst_bytes",
        "prediction",
        "fetch_fault",
        "fetch_epoch",
        "lane_valid"
      ],
      "handshake": "ready/valid, no partial advancement across fetch context changes"
    },
    {
      "id": "DispatchGroup",
      "producer": "rename",
      "consumer": "rob",
      "fields": [
        "lanes_in_order",
        "rob_identity",
        "src_tags",
        "dst_tags",
        "resource_needs",
        "precise_exception"
      ],
      "handshake": "all valid lanes in a group accept atomically, or none; no partial mutations"
    },
    {
      "id": "Wakeup",
      "producer": "execution",
      "consumer": "iq",
      "fields": [
        "producer_tag",
        "generation",
        "ready",
        "result_valid"
      ],
      "handshake": "killed, recycled or stale tags cannot wake"
    },
    {
      "id": "Completion",
      "producer": "execution",
      "consumer": "rob",
      "fields": [
        "rob_token",
        "producer_tag",
        "value_ref",
        "result",
        "exception",
        "branch",
        "fp_flags"
      ],
      "handshake": "Decoupled holds stable until ready; complete lifecycle validation before state update"
    },
    {
      "id": "RetireBundle",
      "producer": "rob",
      "consumer": "commit_csr",
      "fields": [
        "ordered_prefix",
        "retirement_permit",
        "exception",
        "priv_effects",
        "fp_effects",
        "store_permit"
      ],
      "handshake": "contiguous oldest ready prefix of <=retire width; exception instruction never commits"
    },
    {
      "id": "MemoryRequest",
      "producer": "lsq",
      "consumer": "memory_transport",
      "fields": [
        "paddr",
        "op",
        "size",
        "mask",
        "pma",
        "txn_id",
        "age",
        "commit_permission"
      ],
      "handshake": "no speculative visible write; non-idempotent reads and MMIO serialized"
    },
    {
      "id": "RecoveryCut",
      "producer": "rob",
      "consumer": "recovery",
      "fields": [
        "surviving_token",
        "target_pc",
        "reason",
        "younger_squash_mask",
        "epoch"
      ],
      "handshake": "older preserved, younger invalidated, late responses rejected"
    },
    {
      "id": "ArchitectureTrace",
      "producer": "commit_csr",
      "consumer": "difftest",
      "fields": [
        "ordered_pc",
        "raw_inst",
        "reg_and_fp_results",
        "exception",
        "csr_diff",
        "memory_effects",
        "retire_lane"
      ],
      "handshake": "ordered per-instruction record, including simultaneous two retire and exact fault boundary",
      "external_consumer": true
    }
  ],
  "invariants": [
    {
      "id": "I01",
      "gate": "G1",
      "rule": "Every state key has exactly one mutable owner; consumers use explicit read-only projections or transactions."
    },
    {
      "id": "I02",
      "gate": "G1",
      "rule": "Dispatch group allocation is atomic across ROB, IQ, RAT, PRF/free list and LSQ; no resources consumed on failure."
    },
    {
      "id": "I03",
      "gate": "G1",
      "rule": "Every completion and wakeup validates full live lifetime identity; killed/late responses cannot mutate a new slot."
    },
    {
      "id": "I04",
      "gate": "G1",
      "rule": "Only a contiguous oldest ready retirement prefix may commit; a faulting uop and all younger uops never commit."
    },
    {
      "id": "I05",
      "gate": "G1",
      "rule": "Speculative stores, atomics and non-idempotent MMIO effects never externalize before precise commit permission."
    },
    {
      "id": "I06",
      "gate": "G1",
      "rule": "Recovery preserves older ROB entries and reconstitutes speculative RAT/free-list mapping for precisely the survivors."
    },
    {
      "id": "I07",
      "gate": "G2",
      "rule": "Dual dispatch handles within-group RAW/WAW and x0; dual retire handles older and younger trap/csr/fence conflicts."
    },
    {
      "id": "I08",
      "gate": "G2",
      "rule": "An external transaction id outlives its ROB token if needed; cancel drains or discards the transport response safely."
    },
    {
      "id": "I09",
      "gate": "G3",
      "rule": "PTW sees latest coherent PTE including dirty DCache state; SFENCE.VMA/FENCE.I enforce their respective visibility domains."
    },
    {
      "id": "I10",
      "gate": "G3",
      "rule": "FP results/fflags/FS state update only on matching in-order commit; squashed FP operations have no CSR side effects."
    },
    {
      "id": "I11",
      "gate": "G4",
      "rule": "AXI width/txn/CDC, PMA, device map and PHY state remain outside the CPU architectural backend."
    },
    {
      "id": "I12",
      "gate": "G4",
      "rule": "Hardware bitstream and Debian LP64D claims require explicit board and software qualification, never inferred from virtual FPGA Linux."
    }
  ],
  "event_priority": [
    {
      "when": "head synchronous exception",
      "must": "no faulting or younger retirement, precise trap; older normal prefix may have retired",
      "before": "younger branch/commit effects"
    },
    {
      "when": "validated older branch redirect",
      "must": "invalidate strictly younger ROB/IQ/LSQ/FU/fetch epoch; preserve older in-flight effects",
      "before": "younger execution or redirect"
    },
    {
      "when": "younger branch redirect and older fault",
      "must": "older fault eventually wins architectural state; younger never irrevocable",
      "before": "younger external side effects"
    },
    {
      "when": "interrupt pending",
      "must": "G1 take only at drained clean boundary, not inside dual-retirement group; G2 interrupt cut remains precise",
      "before": "next speculative dispatch"
    },
    {
      "when": "same-cycle dual retire",
      "must": "commit lane0 before lane1; stop at first fault or blocked non-reorderable effect",
      "before": "younger architectural update"
    },
    {
      "when": "store/AMO or MMIO",
      "must": "only exact retired permit for external visibility, serialized as platform requires",
      "before": "physical write"
    },
    {
      "when": "FP flags and CSR/trap",
      "must": "accumulate pending effects per-uop; commit only in oldest-to-youngest order",
      "before": "architectural CSR mutation"
    }
  ],
