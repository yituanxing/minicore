SHELL := /bin/bash
.SHELLFLAGS := -euo pipefail -c

BUILD_DIR ?= build/rv32imu-syscalls
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32imu.cpp
GENERATED_DIFFTEST := $(BUILD_DIR)/nemu_difftest_rv32imu.cpp
TOP := AetherCoreRV32IMUSimTop
VERILATOR ?= verilator
RV32_NEMU_SO ?=
STALL_PERIODS := 0 5
FIRST_USER_ECALL_EVENT := 12

RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl software contract runner-source difftest-source sim local-reference run mismatch-probe clean

all: run

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32IMU --target-dir $(RTL_DIR)

software:
	python3 tools/make_rv32imu_syscalls.py $(SOFTWARE_DIR)

contract: software
	python3 tools/check_rv32imu_syscall_contract.py \
		$(SOFTWARE_DIR)/user-syscalls.bin \
		$(SOFTWARE_DIR)/labels.txt \
		$(SOFTWARE_DIR)/contract.txt

runner-source:
	mkdir -p $(BUILD_DIR)
	sed 's/VAetherCoreSimTop/VAetherCoreRV32IMUSimTop/g' sim/sim_main.cpp > $(GENERATED_MAIN)
	python3 -c 'from pathlib import Path; p=Path("$(GENERATED_MAIN)"); s=p.read_text(); a="  commit.exception = top.io_commit_exception;\n  return commit;"; b="  commit.exception = top.io_commit_exception;\n  commit.exceptionCause = static_cast<std::uint64_t>(top.io_commit_exceptionCause);\n  commit.exceptionValue = static_cast<std::uint64_t>(top.io_commit_exceptionValue);\n  return commit;"; c="      if (difftest) std::cout << \", difftest=\" << difftest->checkedCommits();"; d="      if (difftest) std::cout << \", difftest=\" << difftest->checkedCommits() << \", zicsr-shadow=\" << difftest->zicsrShadowSteps() << \", trap-shadow=\" << difftest->trapShadowSteps() << \", mret-shadow=\" << difftest->mretShadowSteps();"; assert a in s and c in s; p.write_text(s.replace(a,b,1).replace(c,d,1))'

difftest-source:
	python3 tools/make_rv32imu_difftest.py \
		sim/nemu_difftest_rv32.cpp $(GENERATED_DIFFTEST)

sim: rtl runner-source difftest-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IMU SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) \
		$(abspath $(GENERATED_DIFFTEST))

local-reference: sim contract
	mkdir -p $(BUILD_DIR)/logs
	$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/user-syscalls.bin \
		--max-cycles 20000 --self-check-exit --stall-period 5 \
		2>&1 | tee $(BUILD_DIR)/logs/local-reference.log
	grep -Fx 'hello from U-mode via SYS_WRITE' $(BUILD_DIR)/logs/local-reference.log >/dev/null
	grep -Fq 'PASS: self-check exit=0' $(BUILD_DIR)/logs/local-reference.log

run: sim contract
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the exact RV32 NEMU reference"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(BUILD_DIR)/logs
	@for stall in $(STALL_PERIODS); do \
		echo "== RV32IMU syscalls: stall=$$stall =="; \
		args=""; \
		if [[ "$$stall" != "0" ]]; then args="--stall-period $$stall"; fi; \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/user-syscalls.bin \
			--max-cycles 20000 --self-check-exit $$args \
			--difftest "$(RV32_NEMU_SO)" \
			2>&1 | tee $(BUILD_DIR)/logs/stall-$$stall.log; \
		grep -Fx 'hello from U-mode via SYS_WRITE' $(BUILD_DIR)/logs/stall-$$stall.log >/dev/null; \
		grep -Fq 'PASS: self-check exit=0' $(BUILD_DIR)/logs/stall-$$stall.log; \
	done

mismatch-probe: sim contract
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the exact RV32 NEMU reference"; exit 1; }
	mkdir -p $(BUILD_DIR)/logs
	@set +e; \
	AETHERCORE_RV32_DIFFTEST_INJECT_MISMATCH_AT=$(FIRST_USER_ECALL_EVENT) \
		$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/user-syscalls.bin \
		--max-cycles 20000 --self-check-exit --stall-period 5 \
		--difftest "$(RV32_NEMU_SO)" \
		> $(BUILD_DIR)/logs/mismatch.log 2>&1; \
	status=$$?; \
	set -e; \
	test "$$status" -ne 0; \
	grep -q 'RV32 DiffTest mismatch after $(FIRST_USER_ECALL_EVENT) matched events' $(BUILD_DIR)/logs/mismatch.log; \
	grep -q 'x31' $(BUILD_DIR)/logs/mismatch.log

clean:
	rm -rf $(BUILD_DIR)
