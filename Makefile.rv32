BUILD_DIR ?= build/rv32
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32.cpp
TOP := AetherCoreRV32SimTop
VERILATOR ?= verilator
RV32_NEMU_SO ?=

# Expanded after the `rtl` prerequisite has emitted the complete module tree.
RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl workload runner-source sim run run-difftest clean

all: run

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32 --target-dir $(RTL_DIR)

workload:
	bash tools/build_rv32_workload.sh $(SOFTWARE_DIR)

runner-source:
	mkdir -p $(BUILD_DIR)
	sed 's/VAetherCoreSimTop/VAetherCoreRV32SimTop/g' sim/sim_main.cpp > $(GENERATED_MAIN)

sim: rtl runner-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32 SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) $(abspath sim/nemu_difftest_rv32.cpp)

run: sim workload
	$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/rv32_smoke.bin \
		--max-cycles 200000 --self-check-exit --stall-period 5

run-difftest: sim workload
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the frozen RV32 NEMU reference"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/rv32_smoke.bin \
		--max-cycles 200000 --self-check-exit --stall-period 5 \
		--difftest $(RV32_NEMU_SO)

clean:
	rm -rf $(BUILD_DIR)
