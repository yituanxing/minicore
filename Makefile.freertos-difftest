include Makefile.freertos

FREERTOS_DIFFTEST_CPP := $(BUILD_DIR)/nemu_difftest_rv32_freertos.cpp
DIFFTEST_SIM_OBJ_DIR := $(BUILD_DIR)/difftest-sim-obj
DIFFTEST_LOG_DIR := $(BUILD_DIR)/logs

RV32_NEMU_SO ?=
STALL_PERIOD ?= 5
DIFFTEST_LOG ?= $(DIFFTEST_LOG_DIR)/difftest-stall$(STALL_PERIOD).log
NEGATIVE_LOG ?= $(DIFFTEST_LOG_DIR)/difftest-negative-stall$(STALL_PERIOD).log

.PHONY: difftest-adapter difftest-runner-source difftest-sim run-difftest run-difftest-negative

difftest-adapter: $(FREERTOS_DIFFTEST_CPP)

$(FREERTOS_DIFFTEST_CPP): sim/nemu_difftest_rv32_timer.cpp tools/make_freertos_difftest_adapter.py
	python3 tools/make_freertos_difftest_adapter.py $< $@

difftest-runner-source: runner-source
	python3 -c 'from pathlib import Path; p=Path("$(GENERATED_MAIN)"); s=p.read_text(); a="      if (difftest) std::cout << \", difftest=\" << difftest->checkedCommits();\n"; b="      if (difftest) {\n        std::cout << \", difftest=\" << difftest->checkedCommits()\n                  << \", zicsr-shadow=\" << difftest->zicsrShadowSteps()\n                  << \", trap-shadow=\" << difftest->trapShadowSteps()\n                  << \", mret-shadow=\" << difftest->mretShadowSteps()\n                  << \", interrupt-shadow=\" << difftest->interruptShadowSteps();\n      }\n"; assert s.count(a) == 1; p.write_text(s.replace(a,b,1))'

difftest-sim: rtl difftest-runner-source difftest-adapter
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IM trap SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(DIFFTEST_SIM_OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) \
		$(abspath $(FREERTOS_DIFFTEST_CPP))

run-difftest: image difftest-sim
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: RV32_NEMU_SO is required"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(DIFFTEST_LOG_DIR)
	$(DIFFTEST_SIM_OBJ_DIR)/V$(TOP) $(BIN) \
		--max-cycles 2000000 --self-check-exit --stall-period $(STALL_PERIOD) \
		--difftest "$(abspath $(RV32_NEMU_SO))" \
		2>&1 | tee $(DIFFTEST_LOG)
	test "$$(grep -c '^FREERTOS BOOT V11.3.0 RV32IM$$' $(DIFFTEST_LOG))" -eq 1
	test "$$(grep -c '^FREERTOS PASS queue=64 semaphore=8 ticks>=16$$' $(DIFFTEST_LOG))" -eq 1
	grep -Fq 'PASS: self-check exit=0' $(DIFFTEST_LOG)
	grep -Eq 'difftest=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'zicsr-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'trap-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'mret-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'interrupt-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	! grep -Fq 'FAIL:' $(DIFFTEST_LOG)

run-difftest-negative: image difftest-sim
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: RV32_NEMU_SO is required"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(DIFFTEST_LOG_DIR)
	@set +e; \
	AETHERCORE_RV32_DIFFTEST_INJECT_MISMATCH_AT=0 \
		$(DIFFTEST_SIM_OBJ_DIR)/V$(TOP) $(BIN) \
		--max-cycles 2000000 --self-check-exit --stall-period $(STALL_PERIOD) \
		--difftest "$(abspath $(RV32_NEMU_SO))" \
		> $(NEGATIVE_LOG) 2>&1; \
	status=$$?; \
	set -e; \
	test $$status -ne 0
	grep -Fq 'RV32 timer DiffTest mismatch after 0 matched events' $(NEGATIVE_LOG)
