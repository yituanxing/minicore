include Makefile.freertos

FREERTOS_BASE_DIFFTEST_CPP := $(BUILD_DIR)/nemu_difftest_rv32_freertos_base.cpp
FREERTOS_DIFFTEST_CPP := $(BUILD_DIR)/nemu_difftest_rv32_freertos_wfi.cpp
DIFFTEST_GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32im_freertos_difftest.cpp
DIFFTEST_SIM_OBJ_DIR := $(BUILD_DIR)/difftest-sim-obj
DIFFTEST_SIM_BINARY := $(DIFFTEST_SIM_OBJ_DIR)/V$(TOP)
DIFFTEST_LOG_DIR := $(BUILD_DIR)/logs
DIFFTEST_ADAPTER_POSTPROCESSOR ?=
DIFFTEST_RUNNER_TOOL ?= tools/make_freertos_difftest_runner.py

RV32_NEMU_SO ?=
STALL_PERIOD ?= 5
DIFFTEST_LOG ?= $(DIFFTEST_LOG_DIR)/difftest-stall$(STALL_PERIOD).log
NEGATIVE_LOG ?= $(DIFFTEST_LOG_DIR)/difftest-negative-stall$(STALL_PERIOD).log

.PHONY: difftest-adapter difftest-runner-source difftest-sim run-difftest run-difftest-negative

difftest-adapter: $(FREERTOS_DIFFTEST_CPP)

$(FREERTOS_BASE_DIFFTEST_CPP): sim/nemu_difftest_rv32_timer.cpp tools/make_freertos_difftest_adapter.py
	python3 tools/make_freertos_difftest_adapter.py $< $@

$(FREERTOS_DIFFTEST_CPP): $(FREERTOS_BASE_DIFFTEST_CPP) tools/make_freertos_wfi_difftest_adapter.py $(DIFFTEST_ADAPTER_POSTPROCESSOR)
	python3 tools/make_freertos_wfi_difftest_adapter.py $< $@
	@if [[ -n "$(DIFFTEST_ADAPTER_POSTPROCESSOR)" ]]; then \
		python3 "$(DIFFTEST_ADAPTER_POSTPROCESSOR)" "$@" "$@.profiled"; \
		mv "$@.profiled" "$@"; \
	fi

$(DIFFTEST_GENERATED_MAIN): $(GENERATED_MAIN) $(DIFFTEST_RUNNER_TOOL)
	python3 $(DIFFTEST_RUNNER_TOOL) $< $@
difftest-runner-source: $(DIFFTEST_GENERATED_MAIN)

$(DIFFTEST_SIM_BINARY): $(RTL_STAMP) $(DIFFTEST_GENERATED_MAIN) $(FREERTOS_DIFFTEST_CPP)
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IM trap SystemVerilog files in $(RTL_DIR)"; exit 1; }
	+$(VERILATOR) --cc --exe --build -j $(JOBS) $(VERILATOR_TRACE_FLAGS) -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(DIFFTEST_SIM_OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(DIFFTEST_GENERATED_MAIN)) \
		$(abspath $(FREERTOS_DIFFTEST_CPP))

difftest-sim: $(DIFFTEST_SIM_BINARY)

run-difftest: qualification image difftest-sim
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: RV32_NEMU_SO is required"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(DIFFTEST_LOG_DIR)
	$(DIFFTEST_SIM_BINARY) $(BIN) \
		--max-cycles 2000000 --self-check-exit --stall-period $(STALL_PERIOD) \
		--difftest "$(abspath $(RV32_NEMU_SO))" \
		2>&1 | tee $(DIFFTEST_LOG)
	test "$$(grep -c '^FREERTOS BOOT V11.3.0 RV32IM$$' $(DIFFTEST_LOG))" -eq 1
	test "$$(grep -c '^FREERTOS TICKLESS PASS sleep>=1 wake>=1 suppressed>=2$$' $(DIFFTEST_LOG))" -eq 1
	test "$$(grep -c '^FREERTOS PASS queue=64 semaphore=8 ticks>=48$$' $(DIFFTEST_LOG))" -eq 1
	grep -Fq 'PASS: self-check exit=0' $(DIFFTEST_LOG)
	grep -Eq 'wfi-commits=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'masked-wfi-commits=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'wfi-sleep-cycles=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'difftest=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'zicsr-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'trap-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'fence-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'wfi-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'mret-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	grep -Eq 'interrupt-shadow=[1-9][0-9]*' $(DIFFTEST_LOG)
	! grep -Fq 'retired while WFI sleep was asserted' $(DIFFTEST_LOG)
	! grep -Fq 'FAIL:' $(DIFFTEST_LOG)

run-difftest-negative: qualification image difftest-sim
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: RV32_NEMU_SO is required"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	mkdir -p $(DIFFTEST_LOG_DIR)
	@set +e; \
	AETHERCORE_RV32_DIFFTEST_INJECT_MISMATCH_AT=0 \
		$(DIFFTEST_SIM_BINARY) $(BIN) \
		--max-cycles 2000000 --self-check-exit --stall-period $(STALL_PERIOD) \
		--difftest "$(abspath $(RV32_NEMU_SO))" \
		> $(NEGATIVE_LOG) 2>&1; \
	status=$$?; \
	set -e; \
	test $$status -ne 0
	grep -Fq 'RV32 timer DiffTest mismatch after 0 matched events' $(NEGATIVE_LOG)
