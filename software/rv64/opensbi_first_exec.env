# Frozen inputs for the first real RV64 OpenSBI execution slice.
# OpenSBI is pinned to the same unchanged upstream 1.6 revision already used
# by the qualified RV32 Linux/OpenSBI line, but RV64 owns its ISA/ABI/layout.

RV64_OPENSBI_VERSION=1.6
RV64_OPENSBI_REPOSITORY=https://github.com/riscv-software-src/opensbi.git
RV64_OPENSBI_COMMIT=bd613dd92113f683052acfb23d9dc8ba60029e0a
RV64_OPENSBI_PLATFORM=generic
RV64_OPENSBI_XLEN=64
RV64_OPENSBI_ISA=rv64ima_zicsr_zifencei
RV64_OPENSBI_ABI=lp64
RV64_OPENSBI_MMU=sv39
RV64_OPENSBI_FW_TEXT_START=0x80000000
RV64_OPENSBI_PAYLOAD_ADDR=0x80200000
RV64_OPENSBI_PAYLOAD_OFFSET=0x200000
RV64_OPENSBI_FDT_ADDR=0x87f00000
RV64_OPENSBI_MILESTONE='RV64 OpenSBI S-mode payload PASS'
