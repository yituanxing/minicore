# Frozen inputs for the RV32 OpenSBI + Linux bring-up line.
# Keep these immutable until the L32 checkpoint reaches /bin/sh.

LINUX_VERSION=6.6.143
LINUX_ARCHIVE=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.6.143.tar.xz
LINUX_SHA256=dace1f8dc9c0dbf5df14f47e3229cd62c298e83049681731ef229f2ba7592932
LINUX_RV32_DEFCONFIG=rv32_defconfig

OPENSBI_VERSION=1.6
OPENSBI_REPOSITORY=https://github.com/riscv-software-src/opensbi.git
OPENSBI_COMMIT=bd613dd92113f683052acfb23d9dc8ba60029e0a
OPENSBI_RV32_ISA=rv32ima_zicsr_zifencei
OPENSBI_RV32_ABI=ilp32

# PIE-capable Linux-target compiler for OpenSBI and freestanding Linux kernel
# builds. Do not use this ilp32d libc as the eventual L32 userspace ABI; the
# BusyBox/musl soft-float userspace toolchain is a later, separate freeze.
L32_TOOLCHAIN_VERSION=riscv32-ilp32d--glibc--stable-2024.05-1
L32_TOOLCHAIN_ARCHIVE=riscv32-ilp32d--glibc--stable-2024.05-1.tar.xz
L32_TOOLCHAIN_URL=https://toolchains.bootlin.com/downloads/releases/toolchains/riscv32-ilp32d/tarballs/riscv32-ilp32d--glibc--stable-2024.05-1.tar.xz
L32_TOOLCHAIN_SHA256=00112418e6d4b0733019a673b682a39f1ce6300b9448cd840f1194aa4b064192
L32_CROSS_COMPILE_PREFIX=riscv32-buildroot-linux-gnu-

L32_XLEN=32
L32_PLATFORM=generic
