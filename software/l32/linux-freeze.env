# L32 Linux base provenance.
#
# The LEGACY values are the exact historical L32-C checkpoint produced by
# run 31290514249. They are immutable evidence, not the output contract for a
# future rebuild: binary inspection showed that artifact contains incremental
# Kbuild state that is not a clean reproducible recipe.
L32_LINUX_LEGACY_VMLINUX_SHA256=2b0307994ca640b2fead335f690ea6d4ce6e1a5fb67857a31f13999308aa50d7
L32_LINUX_LEGACY_IMAGE_SHA256=5a3c7e2579330b4277e664391c74f966146188a2da07d3bd37fbd99aa7761048
L32_LINUX_LEGACY_CONFIG_SHA256=c344bc909736ad9c8932d077467c473022be69bc4bbeea658c5b743e8b923e27
L32_LINUX_LEGACY_BUILD_CACHE_KEY=e91bff604ed9d93d2fcb2f6049fd104281e2c05ae9e2756af69e6af477c68822
L32_LINUX_LEGACY_RUN_ID=31290514249
L32_LINUX_LEGACY_ARTIFACT_ID=9031239454

# Canonical rebuild identity. The base kernel is rebuilt from a clean Kbuild
# object tree with these neutral, fixed metadata values whenever its validated
# cache is absent. This makes the current base a recipe-derived artifact rather
# than a dependency on one self-hosted runner's historical object state.
L32_LINUX_RECIPE_VERSION=canonical-v1
L32_LINUX_BUILD_USER=aethercore
L32_LINUX_BUILD_HOST=builder
L32_LINUX_BUILD_VERSION=1
L32_LINUX_BUILD_TIMESTAMP='Sun Aug  9 02:34:43 UTC 2026'
L32_LINUX_BUILD_TZ=UTC

# During the #78 migration these three output values intentionally remain the
# legacy values until the first clean canonical-v1 build reports its hashes.
# The cache checker therefore fails closed instead of blessing an unknown base.
L32_LINUX_VMLINUX_SHA256=2b0307994ca640b2fead335f690ea6d4ce6e1a5fb67857a31f13999308aa50d7
L32_LINUX_IMAGE_SHA256=5a3c7e2579330b4277e664391c74f966146188a2da07d3bd37fbd99aa7761048
L32_LINUX_CONFIG_SHA256=c344bc909736ad9c8932d077467c473022be69bc4bbeea658c5b743e8b923e27
L32_LINUX_PHYS_ENTRY=0x80400000
