# SPDX-License-Identifier: Apache-2.0

if SOC_FAMILY_AETHERCORE

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 1000000

config RISCV_SOC_INTERRUPT_INIT
	default y

config RISCV_GP
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 2

# The first-level table occupies entries 0..11. The compact PLIC table starts
# at 12 and contains source IDs zero and one, so the final valid ISR table index
# is 13 and NUM_IRQS must describe fourteen total entries.
config NUM_IRQS
	default 14

endif # SOC_FAMILY_AETHERCORE
