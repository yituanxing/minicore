# Frozen L32 userspace inputs for the BusyBox /bin/sh checkpoint.
# Keep this separate from software/l32/manifest.env so userspace-only changes
# do not retrigger the frozen OpenSBI/kernel workflows.

# Reuse only the compiler/binutils from the pinned Bootlin Linux toolchain.
# Its bundled glibc is ilp32d and must never enter the soft-float userspace.
L32_USERSPACE_BASE_TOOLCHAIN_VERSION=riscv32-ilp32d--glibc--stable-2024.05-1
L32_USERSPACE_CROSS_COMPILE_PREFIX=riscv32-buildroot-linux-gnu-
L32_USERSPACE_ISA=rv32ima_zicsr_zifencei
L32_USERSPACE_ABI=ilp32

MUSL_VERSION=1.2.5
MUSL_ARCHIVE=https://musl.libc.org/releases/musl-1.2.5.tar.gz
MUSL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4

BUSYBOX_VERSION=1.36.1
BUSYBOX_ARCHIVE=https://busybox.net/downloads/busybox-1.36.1.tar.bz2
BUSYBOX_SHA256=b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314
