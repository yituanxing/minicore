SHELL := /bin/bash

BUILD_DIR ?= build/rv32im-littlefs
RTL_DIR := $(BUILD_DIR)/rtl
OBJ_DIR := $(BUILD_DIR)/obj
SOFTWARE_DIR := $(BUILD_DIR)/software
GENERATED_MAIN := $(BUILD_DIR)/sim_main_rv32im.cpp
TOP := AetherCoreRV32IMSimTop
VERILATOR ?= verilator
RV32_NEMU_SO ?=

RTL_SOURCES = $(wildcard $(RTL_DIR)/*.sv)

.PHONY: all rtl workload runner-source sim run clean

all: run

rtl:
	./mill aethercore.runMain aethercore.ElaborateRV32IM --target-dir $(RTL_DIR)

workload:
	bash tools/build_rv32im_littlefs_basic.sh $(SOFTWARE_DIR)

runner-source:
	mkdir -p $(BUILD_DIR)
	sed 's/VAetherCoreSimTop/VAetherCoreRV32IMSimTop/g' sim/sim_main.cpp > $(GENERATED_MAIN)

sim: rtl runner-source
	@test -n "$(RTL_SOURCES)" || { echo "ERROR: no RV32IM SystemVerilog files in $(RTL_DIR)"; exit 1; }
	$(VERILATOR) --cc --exe --build --trace -Wall -Wno-fatal \
		--top-module $(TOP) -Mdir $(OBJ_DIR) \
		-CFLAGS "-std=c++20 -O2 -I$(abspath sim)" -LDFLAGS "-ldl" \
		$(RTL_SOURCES) $(abspath $(GENERATED_MAIN)) $(abspath sim/nemu_difftest_rv32.cpp)

run: sim workload
	@test -n "$(RV32_NEMU_SO)" || { echo "ERROR: set RV32_NEMU_SO to the exact RV32 NEMU reference"; exit 1; }
	@test -f "$(RV32_NEMU_SO)" || { echo "ERROR: RV32 NEMU reference not found: $(RV32_NEMU_SO)"; exit 1; }
	@set -euo pipefail; \
	$(OBJ_DIR)/V$(TOP) $(SOFTWARE_DIR)/littlefs-basic.bin \
	  --max-cycles 50000000 --self-check-exit --stall-period 5 \
	  --difftest $(RV32_NEMU_SO) \
	  2>&1 | tee $(BUILD_DIR)/littlefs.log; \
	grep -q '^LFS_PASS ' $(BUILD_DIR)/littlefs.log; \
	grep -q 'PASS: self-check exit=0' $(BUILD_DIR)/littlefs.log

clean:
	rm -rf $(BUILD_DIR)
